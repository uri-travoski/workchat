# WorkChat Server Configuration
WORKCHAT_IMAGE=ghcr.io/uri-travoski/workchat-server:1.1.0
WORKCHAT_PORT=8080
WORKCHAT_BIND_ADDR=0.0.0.0
WORKCHAT_PUBLIC_URL=http://localhost:8080
WORKCHAT_NAME=WorkChat

# Initial bootstrap owner credentials (only used when database is empty)
WORKCHAT_BOOTSTRAP_ADMIN=admin:ChangeMeNow123!
WORKCHAT_BOOTSTRAP_EMAIL=admin@example.com

# Attachment limits
WORKCHAT_MAX_UPLOAD_MB=100

# Push Notifications via embedded ntfy container
WORKCHAT_NTFY_URL=http://ntfy:80
NTFY_PORT=8082
NTFY_BASE_URL=http://localhost:8082

# Encrypted backup passphrase
WORKCHAT_BACKUP_PASSPHRASE=your-secret-backup-passphrase-change-this
